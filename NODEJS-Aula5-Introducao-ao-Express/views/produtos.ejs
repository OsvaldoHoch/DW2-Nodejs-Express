<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Produtos</title>
</head>
<body>
    <h1 style="text-align: center;">Bem vindo a páginad de Produtos!</h1>
    <a href="../homepage" style="display: flex; flex-direction: column; align-items: center;"><< Voltar</a>

    
    <!-- Comentário em EJS  -->
    <%# comentário... #%>
    
    <!-- Chamando a variável para ser exibida na tela -->
    <%= produtos %>

    <!-- Percorrendo a lista de produtos através do forEach -->
     <% produtos.forEach(produto => { %>
        <p>Produto: <%= produto.nome %> </p>
        <p>Marca: <%= produto.marca %> </p>
        <p>Preço: <%= produto.preco %> </p>
        <br>
        <% }); %>
</body>
</html>